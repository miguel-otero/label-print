# BD Local
CLINIC_DATA_SOURCE=postgres
CLINIC_DATABASE_HOST=localhost
CLINIC_DATABASE_PORT=5432
CLINIC_DATABASE_NAME=clinic_label_print
CLINIC_DATABASE_USER=
CLINIC_DATABASE_PASSWORD=

# Backend y agente de impresion Windows
CLINIC_PRINTER_NAME=ZDesigner ZD230-203dpi ZPL
CLINIC_PRINT_AGENT_TOKEN=
CLINIC_PRINT_AGENT_ID=windows-primary
CLINIC_PRINT_AGENT_STALE_SECONDS=120
CLINIC_LABEL_IMAGES_DIR=/data/label-images

# Retencion: revisar la simulacion antes de activar el borrado definitivo.
CLINIC_DATA_RETENTION_MONTHS=3
CLINIC_RETENTION_ENABLED=false
CLINIC_RETENTION_INTERVAL_MINUTES=60
CLINIC_RETENTION_BATCH_SIZE=500
CLINIC_RETENTION_TIMEZONE=America/Bogota

# Registro y descarga de agentes. Generar secretos distintos, no reutilizar el token anterior.
# Clave administrativa no vacía, sin longitud mínima.
CLINIC_AGENT_ADMIN_KEY=
CLINIC_AGENT_TOKEN_SECRET=
CLINIC_AGENT_PUBLIC_API_URL=http://192.168.11.132:8083/api
CLINIC_AGENT_RELEASE_DIR=/data/agent-release
CLINIC_AGENT_POLL_SECONDS=1
CLINIC_AGENT_HEARTBEAT_SECONDS=10
CLINIC_AGENT_REQUEST_TIMEOUT_SECONDS=15

# Microsoft SQL Server externo
CLINIC_EXTERNAL_DATABASE_HOST=192.168.XX.XX
CLINIC_EXTERNAL_DATABASE_NAME=UNOEEPROD
CLINIC_EXTERNAL_DATABASE_USER=
CLINIC_EXTERNAL_DATABASE_PASSWORD=

# APP de Almacen - SSH
CLINIC_WAREHOUSE_APP_SSH_HOST=192.168.XX.XX
CLINIC_WAREHOUSE_APP_SSH_PORT=22
CLINIC_WAREHOUSE_APP_SSH_USER=
CLINIC_WAREHOUSE_APP_SSH_PASSWORD=

# APP de Almacen - base de datos vista desde el servidor SSH
CLINIC_WAREHOUSE_APP_DATABASE_HOST=127.0.0.1
CLINIC_WAREHOUSE_APP_DATABASE_PORT=5432
CLINIC_WAREHOUSE_APP_DATABASE_NAME=postgres
CLINIC_WAREHOUSE_APP_DATABASE_USER=
CLINIC_WAREHOUSE_APP_DATABASE_PASSWORD=
CLINIC_WAREHOUSE_APP_DATABASE_ENGINE=postgres
